+Map<String, String> resolveProjectVersion(File projectDir) {
+    def timestamp = new SimpleDateFormat("yyyy-MM-dd'T'HH-mm-ss").format(new Date())
+    def releaseVersion = System.getenv('RELEASE_VERSION')?.trim()
+    if (releaseVersion) {
+        return [
+                value    : releaseVersion,
+                source   : 'release',
+                timestamp: timestamp,
+        ]
+    }
+
+    try {
+        def process = new ProcessBuilder('git', '-C', projectDir.absolutePath, 'rev-parse', '--short', 'HEAD')
+                .redirectErrorStream(false)
+                .start()
+        def stdout = new StringBuffer()
+        def stderr = new StringBuffer()
+        process.waitForProcessOutput(stdout, stderr)
+
+        def gitHash = stdout.toString().trim()
+        if (process.exitValue() == 0 && gitHash) {
+            return [
+                    value    : "0.0.0-${timestamp}-${gitHash}",
+                    source   : 'git',
+                    timestamp: timestamp,
+                    gitHash  : gitHash,
+            ]
+        }
+
+        return [
+                value    : "0.0.0-local-${timestamp}",
+                source   : 'fallback',
+                timestamp: timestamp,
+                reason   : process.exitValue() != 0 ? "git-exit-${process.exitValue()}" : 'git-empty-stdout',
+        ]
+    } catch (InterruptedException exception) {
+        Thread.currentThread().interrupt()
+        return [
+                value    : "0.0.0-local-${timestamp}",
+                source   : 'fallback',
+                timestamp: timestamp,
+                reason   : exception.class.simpleName,
+        ]
+    } catch (Exception exception) {
+        return [
+                value    : "0.0.0-local-${timestamp}",
+                source   : 'fallback',
+                timestamp: timestamp,
+                reason   : exception.class.simpleName,
+        ]
+    }
+}
+
